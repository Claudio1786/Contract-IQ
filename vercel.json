{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://contract-iq-api.vercel.app/api/:path*"
    }
  ]
}
