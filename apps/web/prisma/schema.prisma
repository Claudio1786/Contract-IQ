// Contract IQ Database Schema
// Backend for customer revenue intelligence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organizations (multi-tenancy)
model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     User[]
  contracts Contract[]
}

// Users
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  
  // New relations for negotiation features
  templates      ContractTemplate[]
  
  @@index([organizationId])
}

// Core Contracts Table
model Contract {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  
  // File metadata
  fileName         String
  fileUrl          String?
  fileSizeBytes    Int?
  uploadedAt       DateTime     @default(now())
  
  // Contract identification
  customerName     String
  customerType     String?      // 'Enterprise', 'Mid-Market', 'SMB', 'Startup'
  industry         String?      // 'FinTech', 'Healthcare', 'SaaS', 'Retail', etc.
  contractType     String?      // 'MSA', 'SOW', 'Order Form', 'Amendment'
  effectiveDate    DateTime?
  
  // Term & Renewal (MANUALLY ENTERED)
  initialTermEndDate      DateTime
  renewalType             String   // 'AUTO_RENEWAL', 'MANUAL_RENEWAL', 'ONE_TIME'
  renewalNoticeDays       Int?
  renewalNoticeDeadline   DateTime? // Calculated field
  whoCanTerminate         String?   // 'EITHER_PARTY', 'CUSTOMER_ONLY', 'PROVIDER_ONLY'
  
  // Pricing
  pricingModel     String?      // 'PER_USER', 'FLAT_FEE', 'USAGE_BASED', 'HYBRID'
  baseMonthlyFee   Decimal?     @db.Decimal(10, 2)
  baseAnnualFee    Decimal?     @db.Decimal(10, 2)
  currency         String       @default("USD")
  committedSeats   Int?
  
  // Contract value
  totalContractValue  Decimal? @db.Decimal(12, 2)
  annualContractValue Decimal? @db.Decimal(12, 2)
  
  // Status
  status              String   @default("active") // 'active', 'archived', 'expired'
  manualEntryComplete Boolean  @default(false)
  
  // New fields for negotiation features
  stage               String?  @default("draft") // 'draft', 'sent', 'negotiating', 'signed'
  templateId          String?
  userId              String?  // Track who created the contract
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  riskScore        RiskScore?
  
  // New relations
  template            ContractTemplate?    @relation(fields: [templateId], references: [id])
  negotiation         NegotiationSession?
  
  @@index([organizationId])
  @@index([customerName])
  @@index([renewalNoticeDeadline])
}

// Risk Scores
model RiskScore {
  id                     String   @id @default(cuid())
  contractId             String   @unique
  contract               Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  // Overall risk
  overallRiskScore       Int      // 0-100
  riskClassification     String   // 'HIGH', 'MEDIUM', 'LOW'
  
  // Risk breakdown
  renewalRiskScore       Int
  pricingRiskScore       Int
  terminationRiskScore   Int
  complianceRiskScore    Int
  relationshipRiskScore  Int
  
  // Risk factors (JSON)
  renewalRiskFactors     Json?
  pricingRiskFactors     Json?
  terminationRiskFactors Json?
  
  // Recommended actions (JSON array)
  recommendedActions     Json?
  
  calculatedAt           DateTime @default(now())
  calculationVersion     String   @default("v1.0.0")
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Salesforce Connections (optional for MVP)
model SalesforceConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  
  accessToken    String
  refreshToken   String
  instanceUrl    String
  
  connectedAt    DateTime
  lastSyncAt     DateTime?
  syncStatus     String   @default("connected")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTRACT TEMPLATES - User's standard agreements they reuse
// ═══════════════════════════════════════════════════════════════════════════

model ContractTemplate {
  id               String   @id @default(cuid())
  userId           String
  name             String   // "Standard MSA", "Services Agreement", "SOW Template"
  description      String?  // "Our standard contract for enterprise customers"
  templateType     String   @default("custom") // 'msa', 'services', 'sow', 'nda', 'custom'
  fileUrl          String   // S3/Supabase storage URL to the template file
  fileType         String   @default("pdf") // 'pdf', 'docx'
  variables        Json?    // ["customer_name", "contract_value", "term_length", "payment_terms"]
  isActive         Boolean  @default(true)
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts        Contract[]
}

// ═══════════════════════════════════════════════════════════════════════════
// NEGOTIATION SESSIONS - Tracks the back-and-forth on each contract
// ═══════════════════════════════════════════════════════════════════════════

model NegotiationSession {
  id                  String   @id @default(cuid())
  contractId          String   @unique
  status              String   @default("draft") 
                      // 'draft' = user creating
                      // 'sent' = sent to customer, waiting
                      // 'received_redlines' = customer sent back changes
                      // 'under_review' = user reviewing redlines
                      // 'counter_sent' = user sent counter-proposal
                      // 'approved' = ready to sign
                      // 'signed' = done
  
  originalVersionUrl  String?  // Your version you sent
  customerRedlineUrl  String?  // Customer's marked up version
  currentVersionUrl   String?  // Latest version after negotiations
  versionNumber       Int      @default(1)
  
  totalChanges        Int      @default(0)
  highRiskChanges     Int      @default(0)
  mediumRiskChanges   Int      @default(0)
  lowRiskChanges      Int      @default(0)
  
  lastActivityAt      DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  contract            Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changes             ContractChange[]
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTRACT CHANGES - Each individual redline/change from customer
// ═══════════════════════════════════════════════════════════════════════════

model ContractChange {
  id                    String   @id @default(cuid())
  sessionId             String
  
  changeType            String   // 'addition', 'deletion', 'modification'
  section               String   // "Section 4.2 - Liability", "Payment Terms"
  
  originalText          String?  @db.Text // What you had
  changedText           String?  @db.Text // What customer changed it to
  
  riskScore             String   @default("medium") // 'high', 'medium', 'low'
  riskExplanation       String?  @db.Text // AI explains why this is risky
  suggestedCounter      String?  @db.Text // AI suggests counter-language
  talkingPoints         String[] // AI suggests what to say on a call
  
  userDecision          String   @default("pending") 
                        // 'pending', 'accepted', 'rejected', 'countered'
  userCounterText       String?  @db.Text // If user writes their own counter
  userNotes             String?  @db.Text // Any notes the user adds
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  session               NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
